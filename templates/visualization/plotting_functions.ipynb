   ],
   "source": [
    "\n",
    "def f(x):\n",
    "    return x**2 + 4 * np.cos(x)\n",
    "\n",
    "x = np.linspace(1, 2, 100)\n",
    "y = f(x)\n",
    "\n",
    "fig, ax = plt.subplots()\n",
    "ax.grid(color=\"#88888888\")\n",
    "ax.plot(x, y, color=\"red\")\n",
    "plt.show()\n",
    "\n"
   ]
  }
 ],
